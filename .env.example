# Copy this file to `.env` and fill in values. Never commit `.env`.

# Postgres (the docker-compose service maps host port 5435 -> container 5432)
DATABASE_URL="postgresql://miniride:miniride@localhost:5435/miniride?schema=public"

# Redis (docker-compose maps host port 6381 -> container 6379)
REDIS_URL="redis://localhost:6381"

# OPTIONAL — leave blank to run in free "mock" mode (no AI calls).
# Add a key from https://console.anthropic.com to get real AI-written scripts.
ANTHROPIC_API_KEY=
